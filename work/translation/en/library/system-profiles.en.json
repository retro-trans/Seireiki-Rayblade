  "rows": [
    {
      "id": "system.profile.000.l00",
      "profile": 0,
      "line": 0,
      "ends_with_newline": true,
      "source_sha256": "973c2e0a99d8fecef95f762ac3184fa89a7cdb9db776ee235a1ee6afde294f2c",
      "en": "A handsome young man with a slightly brooding air.",
      "status": "source-linked editorial draft; independent review pending"
    },
    {
      "id": "system.profile.000.l01",
      "profile": 0,
      "line": 1,
      "ends_with_newline": true,
      "source_sha256": "6dae1515a51cc6c3f52bfdde379c88ee452a83085cc7a8f72c8a83fd24a6d11f",
      "en": "At heart, he has a fairly hot-blooded streak.",
      "status": "source-linked editorial draft; independent review pending"
    },
    {
      "id": "system.profile.000.l02",
      "profile": 0,
      "line": 2,
      "ends_with_newline": true,
      "source_sha256": "11d85530fd0271b3893858046e9b53584c90ebb944e34763095f98baddf68d39",
      "en": "He doesn't mind it himself, but he is rather blunt and foul-mouthed.",
      "status": "source-linked editorial draft; independent review pending"
    },
    {
      "id": "system.profile.000.l03",
      "profile": 0,
      "line": 3,
      "ends_with_newline": true,
      "source_sha256": "aacb5e980c0c3f8d49702bb4a254453a0b409f7720b9676608acc4448a2f0ce3",
      "en": "He suddenly gets caught up in a disturbance of causality around him,",
      "status": "source-linked editorial draft; independent review pending"
    },
    {
      "id": "system.profile.000.l04",
      "profile": 0,
      "line": 4,
      "ends_with_newline": true,
      "source_sha256": "a37fc3d4c238a720b2357e5a66c9e311189fa97202c4b1319027d7bad6767a57",
      "en": "and is summoned to Agarthia, a world in another dimension,",
      "status": "source-linked editorial draft; independent review pending"
    },
    {
      "id": "system.profile.000.l05",
      "profile": 0,
      "line": 5,
      "ends_with_newline": true,
      "source_sha256": "26b6f5684e899c13dafa93df93686f804758e0ab99b39eb06887a2f140c278b4",
      "en": "where he ends up fighting the Ze=Ode that caused it all.",
      "status": "source-linked editorial draft; independent review pending"
    },
    {
      "id": "system.profile.000.l06",
      "profile": 0,
      "line": 6,
      "ends_with_newline": true,
      "source_sha256": "338238963b6db65fe601d90c2bcd700565fc4b390d12cbb0ea74c95eb0eb05cc",
      "en": "He pilots the Spirit Mech Zeifon.",
      "status": "source-linked editorial draft; independent review pending"
    },
    {
      "id": "system.profile.000.l07",
      "profile": 0,
      "line": 7,
      "ends_with_newline": true,
      "source_sha256": "70334f0e3dd9e1b30cea56755756dd0f6b8001ee833b0076be11dc8b1fc488a9",
      "en": "He later becomes the pilot of the Spirit Mech Rayblade.",
      "status": "source-linked editorial draft; independent review pending"
    },
    {
      "id": "system.profile.000.l08",
      "profile": 0,
      "line": 8,
      "ends_with_newline": false,
      "source_sha256": "ee1c28f2a157fce0102cb9e6da27ad8393ece12eeb22c813e95bf5675004e6ce",
      "en": "On Rayblade, he handles the weapons and main controls.",
      "status": "source-linked editorial draft; independent review pending"
    },
    {
      "id": "system.profile.001.l00",
      "profile": 1,
      "line": 0,
      "ends_with_newline": true,
      "source_sha256": "f4ccc7c679c37a1691c8342377585ee95dec8c1608ce09ae8c8f25c1d349ccb6",
      "en": "Unearthed in Orthodox Calendar year 5959, it is maintained",
      "status": "source-linked editorial draft; independent review pending"
    },
    {
      "id": "system.profile.001.l01",
      "profile": 1,
      "line": 1,
      "ends_with_newline": true,
      "source_sha256": "3eb5f2f110f361ba332636118a96f6fec52b69b42fdcced8a93305878cb99262",
      "en": "and researched in the Holy Land.",
      "status": "source-linked editorial draft; independent review pending"
    },
    {
      "id": "system.profile.001.l02",
      "profile": 1,
      "line": 2,
      "ends_with_newline": true,
      "source_sha256": "ca3e05e09fd49378dbe96a82d69c6b6b611d63df3b5c8e03a3f126132018f329",
      "en": "It also served as the foundation for the La=Dis Spirit Mechs.",
      "status": "source-linked editorial draft; independent review pending"
    },
    {
      "id": "system.profile.001.l03",
      "profile": 1,
      "line": 3,
      "ends_with_newline": true,
      "source_sha256": "bfc942c78ce4c099dc62098b4ee66d43f98b5be8bcc65c12f03a19ec6828fc26",
      "en": "Although some of its workings are understood, much",
      "status": "source-linked editorial draft; independent review pending"
    },
    {
      "id": "system.profile.001.l04",
      "profile": 1,
      "line": 4,
      "ends_with_newline": true,
      "source_sha256": "965385c12aa69970d0b3e83498b2e9999d93c29b3fe1202788d57098caaa34a8",
      "en": "remains unknown.",
      "status": "source-linked editorial draft; independent review pending"
    },
    {
      "id": "system.profile.001.l05",
      "profile": 1,
      "line": 5,
      "ends_with_newline": true,
      "source_sha256": "6e2b6e059fa9186c96af7ce29973f295373deb1b9f543b2a191c4e9a360852c0",
      "en": "Why it will only activate when two pilots are together",
      "status": "source-linked editorial draft; independent review pending"
    },
    {
      "id": "system.profile.001.l06",
      "profile": 1,
      "line": 6,
      "ends_with_newline": false,
      "source_sha256": "bfaeab413956af0648798c3e6cf1db0988cfbd42c6defd46eef26ccba3c663b5",
      "en": "also remains unknown.",
      "status": "source-linked editorial draft; independent review pending"
    }
  ],
