  "English_lines": [
    "Dear Touya,",
    "I've made breakfast for you.",
    "Please warm up the miso soup again.",
    "I didn't see Yamato anywhere,",
    "but I've put out food for her too.",
    "P.S.",
    "I'm sorry about earlier.",
    "But you'll catch a cold if you sleep dressed like that.",
    "And one more thing:",
    "Don't be late.",
    "Kasumi"
  ],
